# Copy to .env and fill in. Nothing here is committed.

# Courier A tracking API. Multiple keys may be supplied, comma-separated;
# the pool is rotated automatically when a key hits its rate limit.
COURIER_API_KEYS=key-one,key-two

# Courier B tracking API (OAuth2 client credentials).
COURIER_CLIENT_ID=
COURIER_CLIENT_SECRET=

# Forward-geocoding for the map view.
GEOCODE_API_KEY=

# Port the API listens on.
PORT=5000

# Optional assistant and speech. Both are off unless configured; the chat
# panel falls back to the local rule-based router when ASSISTANT_API_KEY is
# empty, which is the default and needs no credentials at all.
ASSISTANT_API_KEY=
SPEECH_API_KEY=
SPEECH_ENDPOINT=
SPEECH_VOICE_ID=
