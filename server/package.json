{
  "name": "tracking-dashboard",
  "private": true,
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "desktop": "electron .",
    "server": "node server.js",
    "dev:all": "concurrently -n API,VITE -c magenta,cyan \"npm:server\" \"npm --prefix frontend run dev\"",
    "start": "concurrently -k -s first -n API,VITE,APP -c magenta,cyan,yellow \"node server.js\" \"npm --prefix frontend run dev\" \"electron .\""
  },
  "dependencies": {
    "axios": "^1.18.0",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "electron": "^28.3.3",
    "vite": "^5.0.0"
  }
}
